rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
        data.uid.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 60)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 80)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserQuote(data, userId) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.userId is string &&
        data.userId == userId &&
        data.text is string &&
        data.text.size() > 0 &&
        data.text.size() <= 280 &&
        data.createdAt is number;
    }

    // Connection validation document (Required by skill for testConnection)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId;
      allow update: if isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // User quotes subcollection
      match /quotes/{quoteId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(quoteId) &&
          isValidUserQuote(incoming(), userId);
        allow update: if isOwner(userId) &&
          isValidId(quoteId) &&
          isValidUserQuote(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(quoteId);
      }
    }
  }
}
